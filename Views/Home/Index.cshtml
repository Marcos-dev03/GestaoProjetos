@{
    ViewData["Title"] = "Dashboard";
}



<div class="dashboard-grid">

    <div class="dashboard-card">

        <div class="dashboard-card-icon">
            <i class="bi bi-kanban"></i>
        </div>

        <div class="dashboard-card-content">

            <span>Projetos</span>

            <strong>0</strong>

            <small>
                Projetos cadastrados
            </small>

        </div>

    </div>


    <div class="dashboard-card">

