@model Gestão_de_projetos.Models.Proposta

@{
    Layout = "_Layout";
    ViewData["Title"] = "Excluir Proposta";
}

<h1>Excluir Proposta</h1>

<h3>Tem certeza que deseja excluir esta proposta?</h3>

<div>
    <h4>Proposta</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Descricao)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Descricao)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TipoProposta)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TipoProposta)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IdProjeto)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdProjeto)
        </dd>

    </dl>

    <form asp-action="Delete">

        <input type="hidden" asp-for="IdProposta" />

        <input type="submit"
               value="Excluir"
               class="btn btn-danger" />

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>
</div>