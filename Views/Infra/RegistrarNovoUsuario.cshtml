@model Gestão_de_projetos.Models.Infra.RegistrarNovoUsuarioViewModel

@{
	Layout = "_AuthLayout";
	ViewData["Title"] = "Criar Conta";
}

<div class="auth-page">

	<div class="auth-card">

		<div class="auth-brand">
			<div class="brand-icon">
				<i class="bi bi-kanban-fill"></i>
			</div>

			<h1>Gestão<span>+</span></h1>

			<p>
				Crie sua conta e comece<br />
				a organizar seus projetos.
			</p>
		</div>

		<div class="auth-content">

			<div class="auth-header">

				<span class="auth-label">
					NOVO USUÁRIO
				</span>

				<h2>Criar sua conta</h2>

				<p>
					Preencha os dados abaixo para continuar.
				</p>

			</div>

			<form asp-action="RegistrarNovoUsuario"
				  method="post"
				  class="auth-form">

				  <div asp-validation-summary="All"
     class="validation-message">
</div>
				@* <div asp-validation-summary="ModelOnly"
					 class="validation-message">
				</div> *@

				<div class="form-group">

	<label asp-for="Nome">
		Nome completo
	</label>

	<div class="input-wrapper">

		<i class="bi bi-person"></i>

		<input asp-for="Nome"
			   placeholder="Digite seu nome completo"
			   autocomplete="name" />

	</div>

	<span asp-validation-for="Nome"
		  class="validation-message">
	</span>

</div>

				<div class="form-group">

					<label asp-for="Email">
						E-mail
					</label>

					<div class="input-wrapper">

						<i class="bi bi-envelope"></i>

						<input asp-for="Email"
							   type="email"
							   placeholder="seuemail@exemplo.com"
							   autocomplete="email" />

					</div>

					<span asp-validation-for="Email"
						  class="validation-message">
					</span>

				</div>

			<div class="form-group">

    <label asp-for="Senha">
        Senha
    </label>

    <div class="input-wrapper">

        <i class="bi bi-lock"></i>

        <input asp-for="Senha"
               type="password"
               placeholder="Digite sua senha"
               autocomplete="new-password"
               id="senhaCadastro" />

        <button type="button"
                class="password-toggle"
                onclick="togglePassword('senhaCadastro', this)">
            <i class="bi bi-eye"></i>
        </button>

    </div>

    <small class="password-help">
        A senha deve possuir no mínimo 8 caracteres, incluindo uma letra maiúscula, um número e um caractere especial.
    </small>

    <span asp-validation-for="Senha"
          class="validation-message">
    </span>

</div>


<div class="form-group">

    <label asp-for="ConfirmarSenha">
        Confirmar senha
    </label>

    <div class="input-wrapper">

        <i class="bi bi-lock-fill"></i>

        <input asp-for="ConfirmarSenha"
               type="password"
               placeholder="Digite a senha novamente"
               autocomplete="new-password"
               id="confirmarSenhaCadastro" />

        <button type="button"
                class="password-toggle"
                onclick="togglePassword('confirmarSenhaCadastro', this)">
            <i class="bi bi-eye"></i>
        </button>

    </div>

    <span asp-validation-for="ConfirmarSenha"
          class="validation-message">
    </span>

</div>

				<button type="submit"
						class="auth-button">

					Criar conta
					<i class="bi bi-arrow-right"></i>

				</button>

			</form>

			<div class="auth-divider">
				<span>já possui uma conta?</span>
			</div>

			<div class="auth-register">

				<a asp-controller="Infra"
				   asp-action="Acessar">

					Voltar para o login

					<i class="bi bi-arrow-left"></i>

				</a>

			</div>

		</div>

	</div>

	<div class="auth-footer">
		© 2026 Gestão de Projetos · Sistema de gerenciamento
	</div>

</div>

@section Scripts {

	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}

	<script>
		function togglePassword(inputId, button) {

			const input = document.getElementById(inputId);
			const icon = button.querySelector("i");

			if (input.type === "password") {

				input.type = "text";

				icon.classList.remove("bi-eye");
				icon.classList.add("bi-eye-slash");

			} else {

				input.type = "password";

				icon.classList.remove("bi-eye-slash");
				icon.classList.add("bi-eye");

			}
		}
	</script>
}