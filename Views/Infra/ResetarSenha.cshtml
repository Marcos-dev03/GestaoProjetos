@model Gestão_de_projetos.Models.Infra.ResetarSenhaViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Redefinir senha";
}

<div class="auth-page">

    <div class="auth-card">

        <div class="auth-brand">

            <div class="brand-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>

            <h1>Gestão<span>+</span></h1>

            <p>
                Crie uma nova senha
                para sua conta.
            </p>

            <div style="margin-top: 20px; color: #777a9c; font-size: 12px;">
                Escolha uma nova senha para continuar utilizando o sistema.
            </div>

        </div>


        <div class="auth-content">

            <div class="auth-header">

                <span class="auth-label">
                    RECUPERAÇÃO
                </span>

                <h2>Redefinir senha</h2>

                <p>
                    Digite sua nova senha abaixo.
                </p>

            </div>


            <form asp-action="ResetarSenha"
                  method="post"
                  class="auth-form">

                <div asp-validation-summary="ModelOnly"
                     class="validation-message">
                </div>


                <input asp-for="Email" type="hidden" />

                <input asp-for="Token" type="hidden" />


                <!-- NOVA SENHA -->

                <div class="form-group">

                    <label asp-for="NovaSenha">
                        Nova senha
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-lock"></i>

                        <input asp-for="NovaSenha"
                               type="password"
                               placeholder="Digite sua nova senha"
                               autocomplete="new-password"
                               id="novaSenha" />

                        <button type="button"
                                class="password-toggle"
                                onclick="togglePassword('novaSenha', this)">

                            <i class="bi bi-eye"></i>

                        </button>

                    </div>

                    <small class="password-help">
                        A senha deve possuir no mínimo 8 caracteres,
                        incluindo uma letra maiúscula, um número e um
                        caractere especial.
                    </small>

                    <span asp-validation-for="NovaSenha"
                          class="validation-message">
                    </span>

                </div>


                <!-- CONFIRMAR NOVA SENHA -->

                <div class="form-group">

                    <label asp-for="ConfirmarNovaSenha">
                        Confirmar nova senha
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-lock-fill"></i>

                        <input asp-for="ConfirmarNovaSenha"
                               type="password"
                               placeholder="Digite a senha novamente"
                               autocomplete="new-password"
                               id="confirmarNovaSenha" />

                        <button type="button"
                                class="password-toggle"
                                onclick="togglePassword('confirmarNovaSenha', this)">

                            <i class="bi bi-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="ConfirmarNovaSenha"
                          class="validation-message">
                    </span>

                </div>


                <button type="submit"
                        class="auth-button">

                    Redefinir senha

                    <i class="bi bi-check-lg"></i>

                </button>

            </form>


            <div class="auth-divider">
                <span>lembrou sua senha?</span>
            </div>


            <div class="auth-register">

                <a asp-controller="Infra"
                   asp-action="Acessar">

                    Voltar para o login

                    <i class="bi bi-arrow-left"></i>

                </a>

            </div>

        </div>

    </div>


    <div class="auth-footer">
        © 2026 Gestão de Projetos · Sistema de gerenciamento
    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        function togglePassword(inputId, button) {

            const input = document.getElementById(inputId);
            const icon = button.querySelector("i");

            if (input.type === "password") {

                input.type = "text";

                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");

            } else {

                input.type = "password";

                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");

            }

        }

    </script>
}