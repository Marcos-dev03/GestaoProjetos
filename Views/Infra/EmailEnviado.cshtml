@{
	Layout = "_AuthLayout";
	ViewData["Title"] = "E-mail enviado";
}

<div class="auth-page">

	<div class="auth-card">

		<div class="auth-brand">

			<div class="brand-icon">
				<i class="bi bi-envelope-check-fill"></i>
			</div>

			<h1>
				Gestão<span>+</span>
			</h1>

			<p>
				Confira sua caixa de entrada.
			</p>

			<div style="margin-top: 20px; color: #777a9c; font-size: 12px;">
				Enviamos as instruções para redefinir sua senha.
			</div>

		</div>


		<div class="auth-content">

			<div class="auth-header">

				<span class="auth-label">
					RECUPERAÇÃO
				</span>

				<h2>
					E-mail enviado
				</h2>

				<p>
					Verifique sua caixa de entrada para
					redefinir sua senha.
				</p>

			</div>


			<div style="
				text-align:center;
				padding:20px 0;
				color:#777a9c;
				font-size:14px;
				">

				<i class="bi bi-envelope-check"
				   style="font-size:42px;">
				</i>

				<p style="margin-top:15px;">
					Caso o e-mail informado esteja cadastrado,
					você receberá um link para criar uma nova senha.
				</p>

				<p>
					Não encontrou? Verifique também a pasta
					<strong>Spam</strong>.
				</p>

			</div>


			<div class="auth-register">

				<a asp-controller="Infra"
				   asp-action="Acessar">

					<i class="bi bi-arrow-left"></i>

					Voltar para o login

				</a>

			</div>

		</div>

	</div>


	<div class="auth-footer">
		© 2026 Gestão de Projetos · Sistema de gerenciamento
	</div>

</div>