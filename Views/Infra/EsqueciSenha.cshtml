@model Gestão_de_projetos.Models.Infra.EsqueciSenhaViewModel

@{
	Layout = "_AuthLayout";
	ViewData["Title"] = "Esqueci minha senha";
}

<div class="auth-page">

	<div class="auth-card">

		<div class="auth-brand">

			<div class="brand-icon">
				<i class="bi bi-kanban-fill"></i>
			</div>

			<h1>
				Gestão<span>+</span>
			</h1>

			<p>
				Recupere o acesso
				à sua conta.
			</p>

			<div style="margin-top: 20px; color: #777a9c; font-size: 12px;">
				Informe seu e-mail para redefinir sua senha
				e recuperar o acesso ao sistema.
			</div>

		</div>

		<div class="auth-content">

			<div class="auth-header">

				<span class="auth-label">
					RECUPERAÇÃO
				</span>

				<h2>
					Esqueci minha senha
				</h2>

				<p>
					Informe seu e-mail para continuar.
				</p>

			</div>


			<form asp-controller="Infra"
				  asp-action="EsqueciSenha"
				  method="post"
				  class="auth-form">

				<div asp-validation-summary="ModelOnly"
					 class="validation-message">
				</div>

				<div class="form-group">

					<label asp-for="Email">
						E-mail
					</label>

					<div class="input-wrapper">

						<i class="bi bi-envelope"></i>

						<input asp-for="Email"
							   type="email"
							   placeholder="seuemail@exemplo.com"
							   autocomplete="email" />

					</div>

					<span asp-validation-for="Email"
						  class="validation-message">
					</span>

				</div>

				<button type="submit"
						class="auth-button">

					Enviar instruções

					<i class="bi bi-arrow-right"></i>

				</button>

			</form>

			<div class="auth-divider">
				<span>lembrou sua senha?</span>
			</div>


			<div class="auth-register">

				<a asp-controller="Infra"
				   asp-action="Acessar">

					Voltar para o login

					<i class="bi bi-arrow-left"></i>

				</a>

			</div>

		</div>

	</div>


	<div class="auth-footer">

		© 2026 Gestão de Projetos · Sistema de gerenciamento

	</div>

</div>


@section Scripts {

	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}

}