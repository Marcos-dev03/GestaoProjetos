@model Gestão_de_projetos.Models.Infra.UsuarioDaAplicacao

@{
	Layout = "_Layout";
	ViewData["Title"] = "Detalhes do Usuário";
}

<h1>Detalhes do Usuário</h1>

<hr />

<dl class="row">

	<dt class="col-sm-2">
		Nome
	</dt>

	<dd class="col-sm-10">
		@Model.Nome
	</dd>

	<dt class="col-sm-2">
		E-mail
	</dt>

	<dd class="col-sm-10">
		@Model.Email
	</dd>

	<dt class="col-sm-2">
		Nome de usuário
	</dt>

	<dd class="col-sm-10">
		@Model.UserName
	</dd>

</dl>

<a asp-action="Edit"
   asp-route-id="@Model.Id"
   class="btn btn-warning">
	Editar
</a>

<a asp-action="Index"
   class="btn btn-secondary">
	Voltar
</a>