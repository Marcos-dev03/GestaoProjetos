@model Gestão_de_projetos.Models.Infra.RegistrarNovoUsuarioViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Novo Usuário";
}

<div class="page-header">

    <div>

        <span class="page-eyebrow">
            ADMINISTRAÇÃO
        </span>

        <h1>
            Novo usuário
        </h1>

        <p>
            Cadastre um usuário e defina quais áreas ele poderá acessar.
        </p>

    </div>

</div>


<div class="content-card">

    <div class="content-card-header">

        <div>

            <h3>
                Dados do usuário
            </h3>

            <span>
                Preencha os dados para cadastrar o usuário.
            </span>

        </div>

    </div>


    <div class="p-4">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="text-danger mb-4">
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="Nome"
                           class="form-label">
                    </label>

                    <input asp-for="Nome"
                           class="form-control"
                           placeholder="Nome completo" />

                    <span asp-validation-for="Nome"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6 mb-3">

                    <label asp-for="Email"
                           class="form-label">
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="usuario@email.com" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6 mb-3">

                    <label asp-for="Senha"
                           class="form-label">
                    </label>

                    <input asp-for="Senha"
                           class="form-control"
                           placeholder="Digite a senha"
                           autocomplete="new-password" />

                    <span asp-validation-for="Senha"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6 mb-3">

                    <label asp-for="ConfirmarSenha"
                           class="form-label">
                    </label>

                    <input asp-for="ConfirmarSenha"
                           class="form-control"
                           placeholder="Confirme a senha"
                           autocomplete="new-password" />

                    <span asp-validation-for="ConfirmarSenha"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <hr class="my-4" />

            <div class="mb-4">

                <h4>
                    Permissões de acesso
                </h4>

                <p class="text-muted">
                    Selecione as áreas que este usuário poderá acessar.
                </p>

            </div>


            <div class="row">

                <div class="col-md-6 mb-3">

                    <div class="form-check">

                        <input asp-for="AcessoProjetos"
                               class="form-check-input"
                               type="checkbox" />

                        <label asp-for="AcessoProjetos"
                               class="form-check-label">

                            <i class="bi bi-kanban me-2"></i>

                            Projetos

                        </label>

                    </div>

                </div>

                <div class="col-md-6 mb-3">

                    <div class="form-check">

                        <input asp-for="AcessoPropostas"
                               class="form-check-input"
                               type="checkbox" />

                        <label asp-for="AcessoPropostas"
                               class="form-check-label">

                            <i class="bi bi-file-earmark-text me-2"></i>

                            Propostas

                        </label>

                    </div>

                </div>

                <div class="col-md-6 mb-3">

                    <div class="form-check">

                        <input asp-for="AcessoConfiguracoes"
                               class="form-check-input"
                               type="checkbox" />

                        <label asp-for="AcessoConfiguracoes"
                               class="form-check-label">

                            <i class="bi bi-gear me-2"></i>

                            Configurações

                        </label>

                    </div>

                </div>

            </div>


            <hr class="my-4" />

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn-primary-custom">

                    <i class="bi bi-person-plus"></i>

                    Cadastrar usuário

                </button>


                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left"></i>

                    Voltar

                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}