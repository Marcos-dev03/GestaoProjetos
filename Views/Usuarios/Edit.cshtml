@model Gestão_de_projetos.Models.Infra.EditarUsuarioViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Editar Usuário";
}

<div class="page-header">

    <div>

        <span class="page-eyebrow">
            ADMINISTRAÇÃO
        </span>

        <h1>
            Editar usuário
        </h1>

        <p>
            Altere os dados e as permissões de acesso deste usuário.
        </p>

    </div>

</div>


<div class="content-card">

    <div class="content-card-header">

        <div>

            <h3>
                Dados do usuário
            </h3>

            <span>
                Atualize as informações da conta.
            </span>

        </div>

    </div>


    <div class="p-4">

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="All"
                 class="text-danger mb-4">
            </div>


            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="Nome"
                           class="form-label">
                    </label>

                    <input asp-for="Nome"
                           class="form-control" />

                    <span asp-validation-for="Nome"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6 mb-3">

                    <label asp-for="Email"
                           class="form-label">
                    </label>

                    <input asp-for="Email"
                           class="form-control" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <hr class="my-4" />


            <h4>
                Permissões de acesso
            </h4>

            <p class="text-muted">
                Marque as áreas que este usuário poderá acessar.
            </p>


            <div class="row">

                <div class="col-md-6 mb-3">

                    <div class="form-check">

                        <input asp-for="AcessoProjetos"
                               class="form-check-input" />

                        <label asp-for="AcessoProjetos"
                               class="form-check-label">

                            <i class="bi bi-kanban me-2"></i>

                            Projetos

                        </label>

                    </div>

                </div>


                <div class="col-md-6 mb-3">

                    <div class="form-check">

                        <input asp-for="AcessoPropostas"
                               class="form-check-input" />

                        <label asp-for="AcessoPropostas"
                               class="form-check-label">

                            <i class="bi bi-file-earmark-text me-2"></i>

                            Propostas

                        </label>

                    </div>

                </div>

                <div class="col-md-6 mb-3">

                    <div class="form-check">

                        <input asp-for="AcessoConfiguracoes"
                               class="form-check-input" />

                        <label asp-for="AcessoConfiguracoes"
                               class="form-check-label">

                            <i class="bi bi-gear me-2"></i>

                            Configurações

                        </label>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn-primary-custom">

                    <i class="bi bi-check-lg"></i>

                    Salvar alterações

                </button>


                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left"></i>

                    Voltar

                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}